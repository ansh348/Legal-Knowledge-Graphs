    {
      "id": "f11",
      "type": "fact",
      "text": "Present petition under Article 32 filed against the detention order.",
      "anchor": {
        "doc_id": "sha256:b26de6f3f947",
        "start_char": 980,
        "end_char": 1090,
        "text_hash": "d2ef0bf0122609fd",
        "display_location": "0",
        "secondary_spans": [],
        "surface_text": "It is against this order of detention that the present petition under Art. 32 of the Constitution has been filed by the petitioner."
      },
      "fact_type": "procedural",
      "actor_source": "court",
      "date": null,
      "date_approximate": false,
      "disputed_by": null,
      "court_finding": null,
